# frame-ancestors replaces X-Frame-Options because the portfolio at
# dkon109.github.io embeds this site as a live preview, and X-Frame-Options
# cannot allow a second origin. Clickjacking protection is unchanged for
# every other origin: only this site and the portfolio may frame it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://dkon109.github.io
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprinted by their status id, so they never change under the same name.
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000

# Rewritten daily by the scheduled fetch.
/assets/data/x-latest.json
  Cache-Control: public, max-age=300
